    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: tb3_1_scan
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: KeepLast
        Reliability Policy: Reliable
        Value: /tb3_1/scan
      Color: 255; 0; 0
      Size (Pixels): 3
      Style: Squares
      Value: true
    - Class: rviz_default_plugins/LaserScan
