      Value: true
    - Class: rviz_default_plugins/Pose
      Enabled: true
      Name: tb3_1_gt
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: KeepLast
        Reliability Policy: Reliable
        Value: /tb3_1/ground_truth
      Axes Length: 0.3
      Axes Radius: 0.02
      Shape: Axes
      Value: true
    - Class: rviz_default_plugins/PoseWithCovariance
      Enabled: true
      Name: tb3_1_amcl
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: KeepLast
        Reliability Policy: Reliable
        Value: /tb3_1/amcl_pose
      Alpha: 1
      Axes Length: 0.25
      Axes Radius: 0.02
      Covariance:
        Orientation:
          Alpha: 0.5
          Color: 255; 255; 127
          Frame: Local
          Offset: 1
          Scale: 1
          Value: true
        Position:
          Alpha: 0.3
          Color: 204; 51; 204
          Scale: 1
          Value: true
        Value: true
      Shape: Axes
      Value: true
    - Class: rviz_default_plugins/Pose
      Enabled: true
      Name: tb3_1_coloc
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: KeepLast
        Reliability Policy: Reliable
